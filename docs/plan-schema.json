{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "goal": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "duration_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        },
        "days_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "notes": {
          "type": "string"
        },
        "created_by": {
          "description": "z. B. Name der KI.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "strength"
        },
        "exercise_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExerciseDefinition"
          }
        },
        "weeks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52
              },
              "label": {
                "description": "z. B. \"Deload\", \"Intensität hoch\".",
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "deload": {
                "default": false,
                "type": "boolean"
              },
              "days": {
                "minItems": 1,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Stabiler Schlüssel des Tages, in jeder Woche gleich (z. B. \"upper-a\")."
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "notes": {
                      "type": "string"
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/ExerciseItem"
                      }
                    }
                  },
                  "required": [
                    "key",
                    "name",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "week",
              "days"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format_version",
        "name",
        "duration_weeks",
        "days_per_week",
        "type",
        "weeks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "goal": {
