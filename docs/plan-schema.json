        },
        "notes": {
          "type": "string"
        },
        "created_by": {
          "description": "z. B. Name der KI.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "rehab"
        },
        "exercise_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExerciseDefinition"
          }
        },
        "weeks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "week": {
                "type": "integer",
                "minimum": 1,
